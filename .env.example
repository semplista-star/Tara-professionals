# Base de dades Postgres (Vercel Postgres, Neon, Supabase...)
DATABASE_URL="postgresql://user:password@host:5432/tara?schema=public"

# Emmagatzematge de fitxers (Vercel Blob) — es genera automàticament
# quan connectes un "Blob store" al teu projecte de Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# NextAuth
NEXTAUTH_SECRET="genera'n un amb: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Notificacions push (genera-les amb: npx web-push generate-vapid-keys --json)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Clau de l'API d'Anthropic per al xat flotant d'IA (obtén-la a console.anthropic.com).
# Configura-la a Vercel: Settings → Environment Variables → ANTHROPIC_API_KEY.
# No la posis mai al codi ni la publiquis al repositori.
ANTHROPIC_API_KEY=""
